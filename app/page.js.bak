}

// ─── TryItNow section ─────────────────────────────────────────────────────────
// Full-width interactive section embedding the DropZone with live SHA-256 output.
function TryItNowSection() {
  const [file,          setFile]          = useState(null);
  const [hash,          setHash]          = useState("");
  const [displayedHash, setDisplayedHash] = useState("");
  const [hashing,       setHashing]       = useState(false);
  const [error,         setError]         = useState(null);

  // When a file is accepted, compute its hash then animate reveal.
  const handleFileAccepted = useCallback(async (acceptedFile) => {
    setFile(acceptedFile);
    setHash("");
    setDisplayedHash("");
    setError(null);
    setHashing(true);

    try {
      const computed = await computeFileHash(acceptedFile);
      setHash(computed);

      // Typewriter animation
      await animateHashReveal(computed, (partial) => {
        setDisplayedHash(partial);
      }, 18);
    } catch (err) {
      setError("Failed to compute hash. Please try again.");
      console.error(err);
    } finally {
      setHashing(false);
    }
  }, []);

  return (
    <section className="relative py-20 px-4 bg-court-surface/20 border-y border-court-border/40 overflow-hidden">
      {/* Subtle glow backdrop */}
      <div className="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_#c9a84c08_0%,_transparent_70%)] pointer-events-none" />
      <div
        className="absolute inset-0 opacity-[0.03] pointer-events-none"
        style={{
          backgroundImage:
            "linear-gradient(rgba(201,168,76,1) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,1) 1px, transparent 1px)",
          backgroundSize: "40px 40px",
        }}
        aria-hidden
      />

      <div className="relative max-w-4xl mx-auto">
        <SectionHeading
          overline="Live Demo"
          title="⚡ Try it Right Here"
          subtitle="Drag any file below to instantly generate its SHA-256 fingerprint — the same cryptographic proof used by courts."
        />

        {/* DropZone */}
        <div className="bg-court-surface border border-court-border rounded-2xl p-6 md:p-8 shadow-xl">
          <DropZone
            onFileAccepted={handleFileAccepted}
            currentFile={file}
            disabled={hashing}
          />

          {/* Hash output area */}
          {(hashing || hash) && (
            <div className="mt-6 space-y-3">
              {/* Label row */}
              <div className="flex items-center justify-between">
                <span className="text-xs font-semibold uppercase tracking-[0.25em] text-court-gold">
                  SHA-256 Fingerprint
                </span>
                {hash && !hashing && (
                  <span className="flex items-center gap-1.5 text-xs text-court-green font-mono">
                    <span className="vc-dot-green" />
                    64 chars · computed locally
                  </span>
                )}
                {hashing && (
                  <span className="flex items-center gap-1.5 text-xs text-court-amber font-mono animate-pulse">
                    <span className="vc-dot-amber" />
                    Computing…
                  </span>
                )}
              </div>

              {/* Hash display — typewriter reveal with a blinking cursor */}
              <div
                className="vc-hash relative font-mono text-sm md:text-base leading-relaxed break-all"
                style={{
                  minHeight:         "3.5rem",
                  letterSpacing:     "0.04em",
                }}
              >
                {displayedHash || (hashing && <span className="text-court-text-dim animate-pulse">···</span>)}
                {/* Blinking cursor while animating */}
                {hashing && (
                  <span
                    className="inline-block w-[2px] h-[1.1em] bg-court-gold ml-0.5 align-middle"
                    style={{ animation: "blink 0.7s step-end infinite" }}
                  />
                )}
                {/* Steady cursor at end until animation completes */}
                {!hashing && displayedHash && displayedHash.length < hash.length && (
                  <span
                    className="inline-block w-[2px] h-[1.1em] bg-court-gold ml-0.5 align-middle"
                    style={{ animation: "blink 0.7s step-end infinite" }}
                  />
                )}
                <style>{`
                  @keyframes blink {
                    0%, 100% { opacity: 1; }
                    50%       { opacity: 0; }
                  }
                `}</style>
              </div>

              {/* Copy button — only when fully revealed */}
              {hash && displayedHash === hash && (
                <CopyHashButton hash={hash} />
              )}
            </div>
          )}

          {/* Error state */}
          {error && (
            <div className="mt-4 flex items-center gap-2 px-4 py-3 rounded-lg bg-court-red/10 border border-court-red/30 text-court-red text-sm font-mono">
              <span>⚠️</span>
              {error}
            </div>
          )}
        </div>

        {/* Privacy note */}
        <p className="mt-5 text-center text-court-text-dim text-xs font-mono flex items-center justify-center gap-2">
          <span className="text-court-gold select-none">💡</span>
          This hash is computed 100% in your browser. Your file never leaves your device.
        </p>
      </div>
    </section>
  );
}

// ─── CopyHashButton ───────────────────────────────────────────────────────────
function CopyHashButton({ hash }) {
  const [copied, setCopied] = useState(false);

  async function handleCopy() {
    try {
      await navigator.clipboard.writeText(hash);
      setCopied(true);
      setTimeout(() => setCopied(false), 2000);
    } catch {
      // Clipboard not available — silently ignore
    }
  }

  return (
    <button
      onClick={handleCopy}
      className={`flex items-center gap-2 self-start px-4 py-1.5 rounded-lg text-xs font-mono font-semibold border transition-all duration-200 ${
        copied
          ? "border-court-green/50 bg-court-green/10 text-court-green"
          : "border-court-gold/30 bg-court-gold/5 text-court-gold hover:bg-court-gold/10 hover:border-court-gold/50"
      }`}
    >
      {copied ? (
        <>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none">
            <path d="M5 13l4 4L19 7" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round" />
          </svg>
          Copied!
        </>
      ) : (
        <>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none">
            <rect x="9" y="9" width="13" height="13" rx="2" stroke="currentColor" strokeWidth="2" />
            <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" stroke="currentColor" strokeWidth="2" />
          </svg>
          Copy Hash
        </>
      )}
    </button>
  );
}

