// ─── Section heading component ─────────────────────────────────────────────────
function SectionHeading({ overline, title, subtitle }) {
  return (
    <div className="text-center mb-14">
      {overline && (
        <span className="inline-block text-xs font-semibold uppercase tracking-[0.3em] text-court-gold mb-3 px-3 py-1 border border-court-gold/30 rounded-full bg-court-gold/5">
          {overline}
        </span>
      )}
      <h2 className="font-judicial text-3xl md:text-4xl text-court-text mt-3">{title}</h2>
      {subtitle && (
        <p className="mt-4 text-court-text-dim max-w-2xl mx-auto text-base leading-relaxed">
          {subtitle}
        </p>
      )}
    </div>
  );
}

