                <div className="text-4xl mb-4 select-none">{p.icon}</div>
                <h3 className="font-judicial text-xl text-court-red mb-3">{p.title}</h3>
                <p className="text-court-text-dim text-sm leading-relaxed">{p.description}</p>

                {/* Bottom accent line */}
                <div className="absolute bottom-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#ff174440] to-transparent
                               opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ════════════════════════════════════════════════════════════════════════
          SECTION 3 — HOW IT WORKS
      ════════════════════════════════════════════════════════════════════════ */}
      <section className="relative py-24 px-4 bg-court-surface/30">
        {/* Background texture */}
        <div
          className="absolute inset-0 opacity-[0.04] pointer-events-none"
          style={{
            backgroundImage:
              "linear-gradient(rgba(201,168,76,1) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,1) 1px, transparent 1px)",
            backgroundSize: "60px 60px",
          }}
          aria-hidden
        />

        <div className="relative max-w-7xl mx-auto">
          <SectionHeading
            overline="Process"
            title="How VeriCourt Works"
            subtitle="Four deterministic steps — from raw PDF to immutable blockchain record. No servers touched your document."
          />

          {/* Steps: horizontal on desktop, vertical on mobile */}
          <div className="relative grid grid-cols-1 md:grid-cols-4 gap-6">
            {/* Connecting line (desktop only) */}
            <div className="hidden md:block absolute top-[3.2rem] left-[12.5%] right-[12.5%] h-[2px] bg-gradient-to-r from-[#42a5f520] via-court-gold/40 to-court-gold/20 pointer-events-none" />

            {STEPS.map((step, idx) => (
              <div key={step.num} className="relative flex flex-col items-center text-center group">
                {/* Numbered circle */}
                <div
                  className={`relative z-10 w-16 h-16 rounded-full flex items-center justify-center mb-5 text-2xl
                               border-2 ${step.border} ${step.bg} group-hover:scale-110 transition-transform duration-300
                               shadow-lg`}
                >
                  <span className="select-none">{step.icon}</span>
                  {/* Step number badge */}
                  <span
                    className={`absolute -top-2 -right-2 w-6 h-6 rounded-full bg-court-bg border ${step.border}
                                 text-[10px] font-mono font-bold ${step.color} flex items-center justify-center`}
                  >
                    {idx + 1}
                  </span>
                </div>

                {/* Card */}
                <div
                  className={`w-full bg-court-surface border ${step.border} rounded-xl p-5
                               group-hover:shadow-[0_0_20px_rgba(0,0,0,0.3)] transition-all duration-300`}
                >
                  <div className={`text-xs font-semibold uppercase tracking-widest mb-1 ${step.color} opacity-80`}>
                    {step.subtitle}
                  </div>
                  <h3 className={`font-judicial text-lg mb-2 ${step.color}`}>{step.title}</h3>
                  <p className="text-court-text-dim text-xs leading-relaxed">{step.description}</p>
                </div>

                {/* Arrow connector (between steps, mobile only) */}
                {idx < STEPS.length - 1 && (
                  <div className="md:hidden mt-3 text-court-border text-xl select-none">↓</div>
                )}
              </div>
            ))}
          </div>

          {/* Bottom note */}
          <p className="text-center text-court-text-dim text-xs font-mono mt-10 border border-court-border/50 rounded-lg px-6 py-3 bg-court-bg/40 max-w-xl mx-auto">
            💡 The contract stores{" "}
            <span className="text-court-gold">only the SHA-256 hash</span> — never the document
            itself. Gas cost is flat regardless of file size.
          </p>
        </div>
      </section>

      {/* ════════════════════════════════════════════════════════════════════════
          SECTION 4 — FEATURES
      ════════════════════════════════════════════════════════════════════════ */}
      <section className="relative py-24 px-4">
        <div className="max-w-7xl mx-auto">
          <SectionHeading
            overline="Capabilities"
            title="Built for Trust at Every Layer"
            subtitle="Each feature is a deliberate architectural decision, not an afterthought. Security is structural."
          />

          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {FEATURES.map((f, idx) => (
              <div
                key={f.title}
                className="group relative bg-court-surface border border-court-border rounded-2xl p-6 shadow-lg
                           hover:border-court-gold/40 hover:shadow-[0_0_24px_rgba(201,168,76,0.08)]
                           transition-all duration-300 overflow-hidden"
                style={{ animationDelay: `${idx * 80}ms` }}
              >
                {/* Subtle top-left gold glow */}
                <div className="absolute top-0 left-0 w-20 h-20 rounded-full bg-[radial-gradient(ellipse_at_center,_#c9a84c08_0%,_transparent_70%)]
                               opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" />

                <div className="text-3xl mb-4 select-none">{f.icon}</div>
                <h3 className="font-judicial text-lg text-court-gold mb-2 group-hover:text-court-gold-lt transition-colors duration-200">
                  {f.title}
                </h3>
                <p className="text-court-text-dim text-sm leading-relaxed">{f.description}</p>

                {/* Animated bottom border */}
                <div className="absolute bottom-0 left-0 h-[2px] bg-gradient-to-r from-court-gold/60 to-court-gold-lt/60
                               w-0 group-hover:w-full transition-all duration-500 rounded-b-2xl" />
              </div>
            ))}
          </div>
        </div>
      </section>


      {/* ════════════════════════════════════════════════════════════════════════
          SECTION 6 — CTA BANNER
      ════════════════════════════════════════════════════════════════════════ */}
      <section className="relative py-24 px-4 overflow-hidden">
        {/* Deep gold glow */}
        <div className="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_#c9a84c12_0%,_transparent_65%)] pointer-events-none" />
        {/* Top / bottom borders */}
        <div className="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-court-gold/30 to-transparent" />
        <div className="absolute bottom-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-court-gold/30 to-transparent" />

        <div className="relative max-w-3xl mx-auto text-center">
          {/* Seal stamp icon */}
          <div className="text-6xl mb-6 select-none animate-float drop-shadow-[0_0_20px_rgba(201,168,76,0.5)]">
            🔏
          </div>

          <h2 className="font-judicial text-4xl md:text-5xl text-court-text mb-4 leading-tight">
            Ready to Verify a{" "}
            <span className="text-court-gold">Judgment?</span>
          </h2>

          <p className="text-court-text-dim text-base md:text-lg mb-10 leading-relaxed max-w-xl mx-auto">
            Upload your court document and receive a cryptographic verdict in seconds. Authentic or forged — the blockchain never lies.
          </p>

          <div className="flex flex-wrap items-center justify-center gap-5">
            <Link
              href="/verify"
              className="vc-btn-primary text-lg px-10 py-4 shadow-[0_0_32px_rgba(201,168,76,0.35)] hover:shadow-[0_0_48px_rgba(201,168,76,0.55)]"
            >
              <span>🔍</span>
              Verify Document Now
            </Link>
            <Link href="/explorer" className="vc-btn-outline text-lg px-10 py-4">
              <span>🔎</span>
              Browse Explorer
            </Link>
          </div>

          {/* Trust indicators */}
          <div className="flex flex-wrap items-center justify-center gap-6 mt-10 text-xs text-court-text-dim font-mono">
            {[
              { icon: "🔒", text: "No uploads — client-side hashing" },
              { icon: "⛓️", text: "Ethereum-compatible chain" },
              { icon: "⚡", text: "Results in under 3 seconds" },
            ].map((t) => (
              <span key={t.text} className="flex items-center gap-2">
                <span>{t.icon}</span>
                {t.text}
              </span>
            ))}
          </div>
        </div>
      </section>
    </main>
  );
}
