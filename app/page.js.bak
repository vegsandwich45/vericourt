// ─── Live-stats hook ───────────────────────────────────────────────────────────
function useLiveStats() {
  const [stats, setStats] = useState({
    totalJudgments: null,
    blockNumber:    null,
    networkName:    null,
    connected:      false,
    loading:        true,
  });

  useEffect(() => {
    let cancelled = false;
    let interval  = null;

    async function fetchStats() {
      try {
        const [netInfo, contract] = await Promise.all([
          getNetworkInfo(),
          Promise.resolve(getReadContract()),
        ]);

        if (cancelled) return;

        let total = null;
        if (contract) {
          try {
            const raw = await contract.getTotalJudgments();
            total     = Number(raw);
          } catch {
            try {
              const raw = await contract.totalJudgments();
              total     = Number(raw);
            } catch {
              total = 0;
            }
          }
        }

        if (!cancelled) {
          setStats({
            totalJudgments: total,
            blockNumber:    netInfo?.blockNumber ?? null,
            networkName:    netInfo?.chainName   ?? null,
            connected:      netInfo?.connected   ?? false,
            loading:        false,
          });
        }
      } catch {
        if (!cancelled) {
          setStats((prev) => ({ ...prev, connected: false, loading: false }));
        }
      }
    }

    fetchStats();
    interval = setInterval(fetchStats, 12_000); // refresh every ~12 s

    return () => {
      cancelled = true;
      clearInterval(interval);
    };
  }, []);

  return stats;
}

// ─── useCountUp hook ──────────────────────────────────────────────────────────
// Animates a counter from 0 to `target` over `duration` ms using setInterval.
function useCountUp(target, duration = 1400) {
  const [count, setCount]   = useState(0);
  const frameRef            = useRef(null);

  useEffect(() => {
    if (target === 0) {
      setCount(0);
      return;
    }

    const steps     = 60;
    const interval  = duration / steps;
    let   current   = 0;

    frameRef.current = setInterval(() => {
      current += target / steps;
      if (current >= target) {
        setCount(target);
        clearInterval(frameRef.current);
      } else {
        setCount(Math.floor(current));
      }
    }, interval);

    return () => clearInterval(frameRef.current);
  }, [target, duration]);

  return count;
}

// ─── Animated counter (for live-stats) ───────────────────────────────────────
function AnimatedCount({ value, duration = 1200 }) {
  const [display, setDisplay] = useState(0);
  const prev                  = useRef(0);

  useEffect(() => {
    if (value === null) return;
    const start     = prev.current;
    const end       = value;
    const startTime = performance.now();

    function step(now) {
      const elapsed  = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const eased    = 1 - Math.pow(1 - progress, 3);
      const current  = Math.round(start + (end - start) * eased);
      setDisplay(current);
      if (progress < 1) requestAnimationFrame(step);
      else prev.current = end;
    }

    requestAnimationFrame(step);
  }, [value, duration]);

  return <>{value === null ? "—" : display.toLocaleString()}</>;
}

